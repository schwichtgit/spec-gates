{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/schwichtgit/spec-gates/specs/001-provable-enforcement-gate/contracts/attestation-record.schema.json",
  "title": "spec-gates attestation record",
  "description": "One record per verify.sh run, appended to .specify/gates/attestations.jsonl and embedded in --json output. Consumers must ignore unknown fields.",
  "type": "object",
  "required": ["v", "ts", "boundary", "policy_sha256", "exit", "gates"],
  "properties": {
    "v": { "const": 1 },
    "ts": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "boundary": { "enum": ["agent", "git", "ci", "unspecified"] },
    "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtime_version": { "type": ["string", "null"] },
    "exit": { "type": "integer", "minimum": 0 },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gateEntry" }
    },
    "spec": {
      "type": "object",
      "description": "Spec-conformance gate summary (feature 002). Optional and additive: absent when the spec gate is policy-disabled, and the record stays v: 1 because consumers ignore unknown fields.",
      "required": [
        "features",
        "parsed",
        "executed",
        "passed",
        "failed",
        "results"
      ],
      "properties": {
        "features": { "type": "integer", "minimum": 0 },
        "parsed": { "type": "integer", "minimum": 0 },
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/featureConformance" }
        }
      }
    },
    "contract": {
      "type": "object",
      "description": "Policy-contract evidence (feature 003). Optional and additive: absent when the policy declares no extends baseline; the record stays v: 1 because consumers ignore unknown fields. Digests may be null when the corresponding artifact is missing (a failing, unsynced contract still attests what it can).",
      "required": [
        "source",
        "version",
        "digest",
        "effective_sha256",
        "deviations"
      ],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "effective_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "deviations": {
          "type": "object",
          "required": ["weakened", "changed"],
          "properties": {
            "weakened": { "type": "integer", "minimum": 0 },
            "changed": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "featureConformance": {
      "type": "object",
      "required": [
        "feature",
        "complete",
        "tasks_total",
        "tasks_unchecked",
        "blocks_parsed",
        "blocks_executed",
        "blocks_passed",
        "blocks_failed",
        "outcome"
      ],
      "properties": {
        "feature": { "type": "string", "minLength": 1 },
        "complete": { "type": "boolean" },
        "tasks_total": { "type": "integer", "minimum": 0 },
        "tasks_unchecked": { "type": "integer", "minimum": 0 },
        "blocks_parsed": { "type": "integer", "minimum": 0 },
        "blocks_executed": { "type": "integer", "minimum": 0 },
        "blocks_passed": { "type": "integer", "minimum": 0 },
        "blocks_failed": { "type": "integer", "minimum": 0 },
        "outcome": {
          "enum": [
            "enforced-pass",
            "enforced-fail",
            "informational",
            "no-criteria"
          ]
        },
        "blocks_covered": {
          "description": "Feature 007: blocks a covering script vouched for at this boundary; not run, so not in blocks_executed.",
          "type": "integer",
          "minimum": 0
        },
        "blocks": {
          "description": "Feature 007: one entry per evaluated accept block, in parse order. Empty when the feature's blocks did not run.",
          "type": "array",
          "items": { "$ref": "#/$defs/blockEntry" }
        }
      }
    },
    "blockEntry": {
      "type": "object",
      "required": [
        "task",
        "ordinal",
        "verifies",
        "result",
        "reason",
        "duration_s"
      ],
      "properties": {
        "task": {
          "description": "The T### id at the start of the task line, or \"-\".",
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "description": "The block's position among the accept blocks of its task line, from 1; the block is named <feature> <task>#<ordinal>.",
          "type": "integer",
          "minimum": 1
        },
        "verifies": {
          "description": "The block's # verifies: label, or null.",
          "type": ["string", "null"]
        },
        "result": {
          "enum": ["pass", "fail", "timeout", "mutation", "covered"]
        },
        "reason": {
          "description": "A fixed runtime string (empty on pass), or the covering script's sanitized line for covered. Never block output.",
          "type": "string"
        },
        "declared_skip": {
          "description": "The boundary spec.cover.at named; present only on a covered entry. CI is never covered.",
          "enum": ["agent", "git"]
        },
        "duration_s": {
          "description": "Seconds the block ran, or for covered the seconds spent asking the script.",
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gateEntry": {
      "type": "object",
      "required": ["name", "result", "duration_s"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bin": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "pinned": { "type": ["string", "null"] },
        "candidates": { "type": ["integer", "null"], "minimum": 0 },
        "checked": { "type": ["integer", "null"], "minimum": 0 },
        "result": { "enum": ["pass", "fail", "warn", "skipped", "planned"] },
        "reason": { "type": "string" },
        "duration_s": { "type": "integer", "minimum": 0 },
        "declared_skip": {
          "description": "Feature 006: the boundary whose skip declaration (a project gate's skip_at) kept the gate from running; present only on such a skipped entry. CI cannot be declared.",
          "enum": ["agent", "git"]
        }
      }
    }
  }
}
