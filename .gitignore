# OS and editor droppings
.DS_Store
Thumbs.db
*.swp
*~

node_modules/
*.log
/tmp/

# Local runtime-version marker written by /speckit.gates.init in real
# projects; in this repo the runtime runs from source.
.specify/gates/.runtime-version

# Claude Mind local memory store (session artifact, not project content)
# Anchored nowhere: the plugin creates the lock in whatever directory the
# session is working in, including spec directories.
# All of its files: the store, the lock, and the write-ahead log it writes
# while a session runs (an accept block saw that one change mid-run).
**/.claude/mind.*

# Projected gate runtime: materialized from extension/runtime/ by CI (and by
# /speckit.gates.init in real projects). Only .specify/gates/policy.json is
# committed; the runtime copies are build artifacts. The contract artifacts
# (baseline.json, baseline.lock.json, policy.effective.json) are NOT listed
# here on purpose — they are committed contract state, not runtime copies.
.specify/gates/verify.sh
.specify/gates/doctor.sh
.specify/gates/canary.sh
.specify/gates/contract.sh
.specify/gates/constitution.sh
.specify/gates/pr-check.sh
.specify/gates/project.sh
.specify/gates/install-shellcheck.sh
.specify/gates/shellcheck.sha256
# install-shellcheck.sh --update writes here; this repository ships its pins
# in extension/runtime/shellcheck.sha256 instead (CONTRIBUTING.md).
.specify/gates/shellcheck.local.sha256
.specify/gates/lib/
.specify/gates/policy.schema.json

# Gate run evidence (attestation log): disposable local artifact, never source.
.specify/gates/attestations.jsonl

# Coverage reports (scripts/coverage.sh): local run output, never source.
coverage/
__pycache__/
