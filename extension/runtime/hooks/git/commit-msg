#!/bin/bash
set -euo pipefail

# Git commit-msg hook.
# Validates commit message format, blocks AI-isms, emoji, and bad patterns
# (rules in lib/message.sh, shared with the PR checks), and enforces the
# protected-change trailers.

MSG_FILE="$1"
# git hands this hook the editor file BEFORE its own cleanup. Drop the
# scissors section (`git commit -v` diff) and comment lines so template text
# such as "# On branch feat/x" or diff content is never checked as message.
COMMENT_CHAR="$(git config core.commentChar 2>/dev/null || true)"
[[ ${#COMMENT_CHAR} -eq 1 ]] || COMMENT_CHAR='#'
MSG=$(awk -v c="$COMMENT_CHAR" '$0 == c " ------------------------ >8 ------------------------" { exit } { print }' "$MSG_FILE" \
    | git -c core.commentChar="$COMMENT_CHAR" stripspace --strip-comments 2>/dev/null) || MSG=$(cat "$MSG_FILE")

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
POLICY_LIB="$PROJECT_ROOT/.specify/gates/lib/policy.sh"
# shellcheck source=/dev/null disable=SC1091
[[ -f "$POLICY_LIB" ]] && source "$POLICY_LIB"

MESSAGE_LIB="$PROJECT_ROOT/.specify/gates/lib/message.sh"
if [[ ! -f "$MESSAGE_LIB" ]]; then
    # Fail closed: the hook is installed but the runtime it enforces is not.
    echo "ERROR: $MESSAGE_LIB not found -- re-project the gates runtime (/speckit.gates.upgrade)." >&2
    exit 1
fi
# shellcheck source=/dev/null disable=SC1091
source "$MESSAGE_LIB"

# --- Message rules (shared with validate-pr.sh and pr-check.sh) ---
gates_message_check commit "$MSG" || true
ERRORS="$GATES_MSG_ERRORS"
WARNINGS="$GATES_MSG_WARNINGS"

# --- Protected files (policy: protected_files.extra, git.protected_change_trailer) ---
# Issue #47. The agent boundary refuses protected edits outright; at the git
# boundary a human commits, so a staged protected path passes only when the
# message's trailer block declares it ("Protected-Change: <path>", one per
# path) and names an approver ("Approved-By: <name>"). The trailer is an
# auditable declaration, not a credential: real approval is CODEOWNERS plus
# branch protection on the server.
if command -v gates_protected_check >/dev/null 2>&1 \
    && gates_protected_trailer_enabled; then
    PROTECTED_STAGED="$(gates_staged_protected_paths)"
    # --no-divider: a `---` line in the body is prose here, not a patch start.
    TRAILERS="$(git interpret-trailers --parse --no-divider "$MSG_FILE" 2>/dev/null || true)"
    DECLARED="$(printf '%s\n' "$TRAILERS" | gates_trailer_values protected-change)"
    APPROVERS="$(printf '%s\n' "$TRAILERS" | gates_trailer_values approved-by)"
    if [[ -n "$PROTECTED_STAGED" || -n "$DECLARED" ]]; then
        # Paths this commit changes. HEAD's own changes count too, so
        # `git commit --amend` of a declared commit is not refused for a
        # trailer whose file is no longer in the (amend-relative) index diff.
        CHANGED="$(git diff --cached --name-only --no-renames 2>/dev/null || true)"
        CHANGED="$CHANGED"$'\n'"$(git diff --name-only --no-renames HEAD^ HEAD 2>/dev/null || true)"
        _rc=0
        gates_protected_check "$PROTECTED_STAGED" "$CHANGED" "$DECLARED" "$APPROVERS" || _rc=$?
        ERRORS=$((ERRORS + _rc))
    fi
fi

# --- Result ---
if [[ "$ERRORS" -gt 0 ]]; then
    echo "" >&2
    echo "Commit message validation failed: $ERRORS error(s), $WARNINGS warning(s)." >&2
    exit 1
fi

if [[ "$WARNINGS" -gt 0 ]]; then
    echo "Commit message accepted with $WARNINGS warning(s)." >&2
fi

exit 0
